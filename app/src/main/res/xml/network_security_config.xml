<?xml version="1.0" encoding="utf-8"?>
<!-- The VESC Project firmware archive is only served over plain HTTP (its certificate doesn't cover the host
     name). Every other address must use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">home.vedder.se</domain>
    </domain-config>
</network-security-config>
