    <string name="packages_library_title">A library, not a package to install</string>
    <string name="packages_library_body">Other packages and scripts import it. In the LispBM editor, import it with pkg::name@package.vescpkg.</string>
    <string name="packages_not_for_this_title">Made for other hardware</string>
    <string name="packages_not_for_this_body">The package\'s own check says it doesn\'t suit this controller. Installed anyway, it may not start or may misbehave.</string>
    <string name="packages_unchecked_title">Compatibility not checked</string>
    <string name="packages_unchecked_body">The package\'s check uses something this app can\'t evaluate, so it may or may not suit this controller. Read its description first.</string>
    <string name="packages_has_lisp">Contains a LispBM program that runs on the controller.</string>
    <string name="packages_has_qml">Contains a screen for VESC Tool. This app doesn\'t run those screens; the package\'s settings appear under Settings when it registers them.</string>
    <string name="packages_has_qml_fullscreen">Contains a full-screen app for VESC Tool. This app doesn\'t run those screens; the package\'s settings appear under Settings when it registers them.</string>
    <string name="packages_open_refloat">Open the Refloat screen</string>
    <string name="packages_install">Install</string>
    <string name="packages_install_title">Install %1$s?</string>
    <string name="packages_install_body">The controller\'s current package or LispBM script and its VESC Tool screen are erased and replaced. Keep it powered until the install finishes; an interrupted install leaves it without a program until you install again. Motor settings are untouched.</string>
    <string name="packages_install_source">The store comes from the VESC Project server over an unencrypted connection, as in VESC Tool.</string>
    <string name="packages_install_incompatible">The package says it doesn\'t suit this controller.</string>
    <string name="packages_installed">%1$s installed</string>
    <string name="packages_installed_body">It runs now. Reconnect to see settings or screens the package adds.</string>
    <string name="packages_uninstalled">Package removed</string>
    <string name="packages_uninstalled_body">The LispBM program and the VESC Tool screen were erased.</string>
    <string name="packages_uninstall_title">Uninstall the current package?</string>
    <string name="packages_uninstall_body">Erases the controller\'s LispBM program and its VESC Tool screen. Settings the package stored stay until another package replaces them.</string>
