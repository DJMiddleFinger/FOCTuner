    <string name="bms_balance_on">Balance on</string>
    <string name="bms_balance_on_body">The BMS starts balancing the higher cells now, drawing a little energy from them, until you turn it off.</string>
    <string name="bms_balance_off">Balance off</string>
    <string name="bms_balance_off_body">Forced balancing stops and the BMS goes back to balancing on its own rules.</string>
    <string name="bms_charge_allow">Allow charging</string>
    <string name="bms_charge_allow_body">The BMS closes its charge path, so a connected charger starts charging the pack.</string>
    <string name="bms_charge_disable">Disable charging</string>
    <string name="bms_charge_disable_body">The BMS opens its charge path and the pack stops charging until charging is allowed again.</string>
    <string name="bms_reset_ah">Reset Ah counter</string>
    <string name="bms_reset_ah_body">The BMS sets its amp-hour counter to zero. The lifetime totals stay.</string>
    <string name="bms_reset_wh">Reset Wh counter</string>
    <string name="bms_reset_wh_body">The BMS sets its watt-hour counter to zero. The lifetime totals stay.</string>
    <string name="bms_zero_current">Zero current offset</string>
    <string name="bms_zero_current_body">The BMS takes the current it measures now as zero. Do this only with no load and no charger connected, or every current reading afterwards is off by that amount.</string>
